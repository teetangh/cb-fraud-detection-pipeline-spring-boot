# Copy to .env and edit if a default port is already taken on your machine.
#   cp .env.example .env
#
# .env is gitignored. scripts/preflight.sh checks these ports before anything
# starts and fails loudly rather than letting compose die halfway up.
#
# Only HOST-side ports are configurable. In-network service-to-service traffic
# uses container ports on the fraud-net bridge and is unaffected.

# ── Host port mappings ───────────────────────────────────────────────────
KAFKA_HOST_PORT=29092
REDIS_HOST_PORT=6379

# Couchbase's web console default (8091) is a frequent collision — it is also
# used by a number of other local dev tools. Change it here if preflight
# reports the port busy.
CB_UI_PORT=8091
CB_QUERY_PORT=8093
CB_KV_PORT=11210

# ── Couchbase credentials ────────────────────────────────────────────────
# Local development only. In any real deployment these come from a secret
# store, not a file — tracked as part of the OAuth2/secrets work in issue #6.
CB_USER=Administrator
CB_PASSWORD=password
CB_BUCKET=fraud-detection

# Couchbase memory quotas in MB. CE minimum for the index service is 256.
# Raising these needs a matching bump to the couchbase mem_limit in
# docker-compose.yml, or the container is OOM-killed during startup.
CB_RAM_DATA=512
CB_RAM_INDEX=256

# ── Shared secret for the HMAC JWT between mock-payment-api and gateway ──
# Spec §13 accepts a shared secret as sufficient for this build. Note the
# weakness this implies: every verifier can also mint. See issue #6.
JWT_SECRET=local-dev-only-not-a-real-secret-change-me
